# BreatheWise Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ── AI Provider (choose one) ──────────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Active AI provider: openai | gemini | anthropic | fallback
AI_PROVIDER=fallback

# ── Air Quality Data ──────────────────────────────────────────────────────────
# WAQI (World Air Quality Index) — free tier available at https://aqicn.org/api/
WAQI_API_KEY=your_waqi_api_key_here

# OpenWeatherMap (optional, for weather context)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_chars
DATABASE_URL=sqlite:///./breathewise.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20
